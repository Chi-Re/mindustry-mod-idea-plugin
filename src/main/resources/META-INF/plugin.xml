<idea-plugin>
    <id>com.example.mindustry-mod</id>
    <name>Mindustry Mod</name>
    <vendor email="3531962676@qq.com" url="https://github.com/Chi-Re/mindustry-mod-idea-plugin">ChiReS</vendor>

    <description><![CDATA[
        Generate Mindustry mod projects with Gradle build system.
        Supports Groovy DSL, auto-fills Mindustry/Arc versions.
        Adds a Mindustry run configuration that builds a mod and launches the game (with debug support).
    ]]></description>

    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <moduleType id="MINDUSTRY_MOD_PROJECT"
                    implementationClass="chire.idea.mindustry.generators.MindustryModuleType"/>
        <moduleBuilder id="MINDUSTRY_MODULE" builderClass="chire.idea.mindustry.generators.MindustryProjectModuleBuilder"/>
        <configurationType implementation="chire.idea.mindustry.run.MindustryConfigurationType"/>
        <applicationConfigurable id="settings.mindustry"
                                  displayName="Mindustry"
                                  instance="chire.idea.mindustry.settings.MindustrySettingsConfigurable"/>
    </extensions>
</idea-plugin>
